<%- include('layout') %>
<div class="card" style="max-width: 440px; margin: 3rem auto;">
  <div class="card-header">
    <h2 class="card-title">Đăng nhập tài khoản</h2>
  </div>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <form action="/login" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-group">
      <label class="form-label">Tên đăng nhập</label>
      <input type="text" name="username" class="form-control" required autofocus>
    </div>
    <div class="form-group">
      <label class="form-label">Mật khẩu</label>
      <input type="password" name="password" class="form-control" required>
    </div>
    <div style="margin-top: 1.5rem;">
      <button type="submit" class="btn btn-primary" style="width: 100%;">Đăng nhập</button>
    </div>
  </form>
  <div style="text-align: center; margin-top: 1.25rem; font-size: 0.9rem; color: var(--text-muted);">
    Chưa có tài khoản khách? <a href="/register" style="color: var(--primary);">Đăng ký tại đây</a>
  </div>
</div>
<%- include('footer') %>
