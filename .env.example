NODE_ENV=production
PORT=3000
SESSION_SECRET=change_this_to_a_random_32_char_secret

# PostgreSQL Database
POSTGRES_DB=restaurant
POSTGRES_USER=restaurant_app
POSTGRES_PASSWORD=change_this_strong_postgres_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://restaurant_app:change_this_strong_postgres_password@db:5432/restaurant

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@restaurant.com
PGADMIN_DEFAULT_PASSWORD=change_this_strong_pgadmin_password

# Passwords cho tài khoản Seed (chỉ demo)
SEED_ADMIN_PASSWORD=change_this_admin_password
SEED_STAFF_PASSWORD=change_this_staff_password
SEED_CUSTOMER_PASSWORD=change_this_customer_password
